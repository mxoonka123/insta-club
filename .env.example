# Токен бота от @BotFather
BOT_TOKEN=put_your_telegram_bot_token_here

# Ник куратора без @
CURATOR_USERNAME=instaclub_curator

# Telegram ID организаторов (цифры). Несколько через запятую: 111,222
ADMIN_IDS=123456789

# Цена на экране тарифа START
BUSINESS_PRICE=19 € / месяц

# Как оплатить — этот текст видит участник после заявки
PAYMENT_DETAILS=Реквизиты пришлёт куратор после заявки. Затем нажмите «Я оплатил» в боте.

# На Railway: /data/profiles.db плюс Volume на /data
# Локально можно оставить пустым — будет файл profiles.db в папке проекта
DB_PATH=

# Обычно не нужно: бот подставляет сам после запуска
BOT_USERNAME=
