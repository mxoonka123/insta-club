# INSTA CLUB
# Product name. Telegram bot token from @BotFather
BOT_TOKEN=put_your_telegram_bot_token_here

# Curator username without @
CURATOR_USERNAME=instaclub_curator

# Organizer Telegram IDs (digits). Several: 111,222
# Get yours from @userinfobot
# 318427459 is also always an organizer in code
ADMIN_IDS=123456789,318427459

# START tariff label shown in the bot
BUSINESS_PRICE=19 € / месяц

# Payment instructions after the application
PAYMENT_DETAILS=Реквизиты пришлёт куратор после заявки. Затем нажмите «Я оплатил» в боте.

# SQLite file. On Railway this MUST be on a Volume, otherwise Redeploy wipes members.
# Railway: /data/instaclub.db  +  Volume mount path /data
# Local: leave empty (file instaclub.db in the project folder)
DB_PATH=

# Optional. Bot fills this in after start (needed for referral links)
BOT_USERNAME=

# Optional. 1 = seed demo catalog cards on an EMPTY database only. Do not enable in production.
SEED_DEMO=
